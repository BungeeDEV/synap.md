# Absolute path inside the container where the vault (your Markdown notes) lives.
# Must be NUXT_-prefixed - Nitro only picks up runtimeConfig overrides at
# container runtime via the NUXT_<KEY> env var convention.
NUXT_VAULT_PATH=/data/vault

# Absolute path inside the container for the SQLite index/cache database.
NUXT_DATA_PATH=/data/app.db

# Secret used for session/auth cookies (Phase 3). Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-secret-of-at-least-32-characters

# Port the server listens on inside the container.
PORT=3000

# Maximum size (in MB) accepted for a single attachment upload.
NUXT_MAX_ATTACHMENT_SIZE_MB=10

# Days a soft-deleted file stays in _trash/ before the hourly cleanup job
# permanently removes it.
NUXT_TRASH_RETENTION_DAYS=30
